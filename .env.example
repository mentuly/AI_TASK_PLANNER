# Local development example
BOT_TOKEN=your_telegram_bot_token_here
# Use DATABASE_URL for PostgreSQL or MySQL, or DB_NAME for local SQLite.
# Example Postgres: postgresql+asyncpg://postgres:postgres@localhost/ai_task_planner
# Example MySQL: mysql+aiomysql://root:secret@localhost/ai_task_planner
DATABASE_URL=sqlite+aiosqlite:///tasks.db
DB_NAME=/app/data/tasks.db
